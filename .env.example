# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Dipakai untuk membentuk URL absolut media yang diunggah admin.
PUBLIC_URL=http://localhost:4000
# URL situs utama (tombol "Buka situs" di dashboard). Di produksi ganti:
# SITE_URL=https://www.spatialindonesia.org/
SITE_URL=http://localhost:8899/index.html

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Boleh pakai DATABASE_URL, atau bagian-bagiannya di bawah. URL menang.
DATABASE_URL=postgres://spatial_app:spatial-indonesia-backend@localhost:5432/spatial_indonesia
PGSSL=false
# Ukuran pool: kecil saja. Situsnya baca-berat dan sudah di-cache di depan,
# jadi koneksi menganggur cuma membebani Postgres.
PG_POOL_MAX=10

# ── Docker Compose ───────────────────────────────────────────────────────────
# Hanya dibaca docker-compose.yml untuk menyiapkan container Postgres. Kalau
# databasenya dikelola pihak lain, ketiganya boleh dikosongkan — yang dipakai
# aplikasi tetap DATABASE_URL di atas.
POSTGRES_DB=spatial_indonesia
POSTGRES_USER=spatial_app
POSTGRES_PASSWORD=

# ── Keamanan ─────────────────────────────────────────────────────────────────
# WAJIB diganti sebelum produksi. Bangkitkan dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=135f72ec92f6679eb072a8fe8f17688063c8dcb29082a6f0cda4218b44c54f6c8e0cad60ccc54e6015a0228789f2272b
JWT_REFRESH_SECRET=9704ab4e6555034382ec17c61c6fd8442de3c942e82a5c68c83e329cb28a6066450a518ed8a9f88511c5f5ccb349a8a7
ACCESS_TOKEN_TTL=15m
# Garam untuk hash IP di tabel pemantauan. WAJIB di produksi, dan harus BERBEDA
# dari JWT secret — merotasi JWT tidak boleh memutus korelasi sumber.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=eb14968df6e0b23fa8cb7976484d1d13554e966dde0a097170e7d54f60cf3891a6aa64c7accd9022e543247e0cd7f490
REFRESH_TOKEN_TTL_DAYS=14
# Origin frontend yang boleh memanggil API. Pisahkan dengan koma.
# 8899 = python3 -m http.server · 5500 = Live Server VS Code.
# Port apa pun boleh, asal origin-nya persis sama dengan yang di address bar
# (localhost dan 127.0.0.1 dihitung dua origin berbeda oleh browser).
CORS_ORIGINS=http://localhost:8899,http://127.0.0.1:8899,http://localhost:5500,http://127.0.0.1:5500
# Cookie sesi admin. Wajib true di produksi (butuh HTTPS).
# Jumlah reverse proxy di depan aplikasi. 0 = langsung, 1 = satu nginx,
# 2 = Cloudflare di depan nginx. Salah hitung membuat pembatas laju bisa
# dikelabui lewat header X-Forwarded-For palsu.
TRUST_PROXY=1

COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── Akun admin pertama (dipakai `npm run seed` & `npm run admin:create`) ─────
ADMIN_EMAIL=admin@spatialindonesia.id
ADMIN_PASSWORD=Ubah-Password-Ini-1
ADMIN_NAME=Administrator
